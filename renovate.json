{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "schedule:monthly",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "America/New_York",
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "allowedVersions": "24.x"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ]
  }
}
